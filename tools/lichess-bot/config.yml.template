# Lichess Bot configuration template for Zanak
# LICHESS_BOT_TOKEN is injected at container startup by entrypoint.sh.

token: "${LICHESS_BOT_TOKEN}"
url: "https://lichess.org/"

engine:
  dir: "/app/engine"
  name: "zanak"
  working_dir: "/app/engine"
  protocol: "uci"
  ponder: false

  polyglot:
    enabled: true
    book:
      standard:
        - "/app/engine/book.bin"
    min_weight: 1
    selection: "weighted_random"
    max_depth: 8
    normalization: "none"

  uci_options:
    Threads: 2
    Hash: 128
    NnuePath: "/app/engine/networks"
    SyzygyPath: "/app/engine/syzygy"

  silence_stderr: false

abort_time: 30
fake_think_time: false
rate_limiting_delay: 0
move_overhead: 1000
max_takebacks_accepted: 0

challenge:
  concurrency: 1
  sort_by: "best"
  preference: "none"
  accept_bot: true
  only_bot: false
  max_increment: 180
  min_increment: 0
  max_base: 1800
  min_base: 0
  max_days: 14
  min_days: 1
  variants:
    - standard
  time_controls:
    - bullet
    - blitz
    - rapid
  modes:
    - casual
    - rated

greeting:
  hello: "Hi! I am zanak-bot, an experimental ZAP (Zero-branching Accelerated Probe) chess engine from the Anak project. Good luck!"
  goodbye: "Good game!"
  hello_spectators: "Hi! Watching zanak-bot (ZAP experimental engine)."
  goodbye_spectators: "Thanks for watching!"

matchmaking:
  allow_matchmaking: false
  challenge_variant: "standard"
  challenge_timeout: 30
  challenge_initial_time:
    - 60
    - 180
  challenge_increment:
    - 0
    - 2
  challenge_days:
    - 1
  opponent_min_rating: 600
  opponent_max_rating: 4000
  challenge_mode: "random"
  challenge_filter: "none"
