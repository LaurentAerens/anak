# Set default behavior to automatically handle line endings and enforce LF
* text=auto eol=lf

# C# and .NET Source Files
*.cs text diff=csharp eol=lf
*.csx text diff=csharp eol=lf
*.csproj text eol=lf
*.sln text eol=lf
*.props text eol=lf
*.targets text eol=lf

# Configuration & Data Files
*.json text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.txt text eol=lf
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf

# Scripts
*.sh text eol=lf
*.ps1 text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary Assets
*.dll binary
*.exe binary
*.pdb binary
*.so binary
*.dylib binary
*.nupkg binary
*.snupkg binary
*.zip binary
*.tar.gz binary
*.7z binary

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf

# Chess Tablebase and Book Binaries
*.bin binary
*.rtbw binary
*.rtbz binary
*.ctbw binary
*.ctbz binary
