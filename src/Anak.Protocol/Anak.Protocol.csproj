<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Anak.Protocol</RootNamespace>
    <AssemblyName>anak</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Anak.Core\Anak.Core.csproj" />
    <ProjectReference Include="..\Anak.Search\Anak.Search.csproj" />
    <ProjectReference Include="..\Anak.Data\Anak.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\networks\*.nnue" Link="networks\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\networks')" />
    <None Include="..\..\book.bin" Link="book.bin" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\book.bin')" />
    <None Include="..\..\syzygy\**\*.*" Link="syzygy\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\syzygy')" />
  </ItemGroup>

</Project>
