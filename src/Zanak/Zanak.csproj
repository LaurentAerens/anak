<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Zanak</RootNamespace>
    <AssemblyName>zanak</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <OptimizationPreference>Speed</OptimizationPreference>
    <IlcOptimizationPreference>Speed</IlcOptimizationPreference>
    <IlcFoldIdenticalMethodBodies>true</IlcFoldIdenticalMethodBodies>
    <StackTraceSupport>false</StackTraceSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
    <MetadataUpdateSupport>false</MetadataUpdateSupport>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Anak.Core\Anak.Core.csproj" />
    <ProjectReference Include="..\Anak.Search\Anak.Search.csproj" />
    <ProjectReference Include="..\Anak.Data\Anak.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\networks\*.nnue" Link="networks\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\networks')" />
  </ItemGroup>

</Project>
